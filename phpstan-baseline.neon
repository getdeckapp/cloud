parameters:
	ignoreErrors:
		-
			message: '#^Instanceof between Illuminate\\Support\\Carbon and Illuminate\\Support\\Carbon will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: src/Commands/CommandApplicator.php

		-
			message: '#^Unsafe call to private method Deck\\Cloud\\DeckCloud\:\:explicitlyDisabled\(\) through static\:\:\.$#'
			identifier: staticClassAccess.privateMethod
			count: 1
			path: src/DeckCloud.php

		-
			message: '#^Unsafe call to private method Deck\\Cloud\\Events\\JobExecutionIngestPayload\:\:shouldSendExceptionTrace\(\) through static\:\:\.$#'
			identifier: staticClassAccess.privateMethod
			count: 1
			path: src/Events/JobExecutionIngestPayload.php

		-
			message: '#^Unsafe call to private method Deck\\Cloud\\Events\\JobExecutionIngestPayload\:\:truncateTrace\(\) through static\:\:\.$#'
			identifier: staticClassAccess.privateMethod
			count: 1
			path: src/Events/JobExecutionIngestPayload.php

		-
			message: '#^Anonymous function with return type void returns null but should not return anything\.$#'
			identifier: return.void
			count: 2
			path: src/Listeners/SyncCloudAgent.php

		-
			message: '#^Call to an undefined method Laravel\\Horizon\\Contracts\\SupervisorRepository\:\:find\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Workers/WorkerSnapshotCollector.php

		-
			message: '#^Call to an undefined method Laravel\\Horizon\\Contracts\\SupervisorRepository\:\:names\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Workers/WorkerSnapshotCollector.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/Workers/WorkerSnapshotCollector.php

		-
			message: '#^Property Deck\\Cloud\\Workers\\WorkerSnapshotCollector\:\:\$horizon is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: src/Workers/WorkerSnapshotCollector.php
